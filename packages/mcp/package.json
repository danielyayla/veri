{
  "name": "@verikb/mcp",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Stdio MCP server for Veri knowledge bases: context packages and write-back",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielyayla/veri.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://danielyayla.github.io/veri/",
  "bugs": "https://github.com/danielyayla/veri/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "veri-mcp": "./dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@verikb/core": "^0.1.0",
    "zod": "^3.25.0"
  }
}
