{
  "name": "@veri/ui",
  "version": "0.1.0",
  "description": "Local desktop UI for Veri knowledge bases: five screens over the veri/ directory",
  "type": "module",
  "private": true,
  "main": "dist/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
