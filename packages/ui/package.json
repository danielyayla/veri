{
  "name": "@veri/ui",
  "version": "0.1.3",
  "description": "Local desktop UI for Veri knowledge bases: a desktop lens over the veri/ directory",
  "type": "module",
  "private": true,
  "main": "dist/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild dist/renderer/app.js --bundle --format=esm --outfile=dist/renderer/app.bundle.js --log-level=warning",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "start": "electron .",
    "dist": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@veri/cli": "^0.1.0",
    "@veri/core": "^0.1.0",
    "@veri/mcp": "^0.1.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3",
    "electron": "38.8.6",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  }
}
