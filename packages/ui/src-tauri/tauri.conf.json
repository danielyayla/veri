{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veri",
  "version": "../package.json",
  "identifier": "io.github.danielyayla.veri",
  "build": {
    "frontendDist": "../dist/frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": {
      "sidecar-stage": "sidecar"
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/danielyayla/veri/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4RENFOUE0QjFCQUJCQkQKUldTOXU3cXhwT25jeUphd1U1UWdsMC94eG5Ua1ViVUxrQXhkZHRpQnduNzFzeW9XUGNCMk45MzkK"
    }
  }
}
