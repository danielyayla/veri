{
  "name": "@veri/cli",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "CLI for Veri knowledge bases over the veri/ directory",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "veri": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "demo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@veri/core": "^0.1.0"
  }
}
