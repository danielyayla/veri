{
  "name": "@veri/core",
  "version": "0.1.0",
  "description": "Parse, validate, and graph a veri/ knowledge directory",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  }
}
