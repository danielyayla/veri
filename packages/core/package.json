{
  "name": "@verikb/core",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Parse, validate, and graph a veri/ knowledge directory",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielyayla/veri.git",
    "directory": "packages/core"
  },
  "homepage": "https://danielyayla.github.io/veri/",
  "bugs": "https://github.com/danielyayla/veri/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ids": {
      "types": "./dist/ids.d.ts",
      "default": "./dist/ids.js"
    },
    "./dates": {
      "types": "./dist/dates.d.ts",
      "default": "./dist/dates.js"
    },
    "./pending": {
      "types": "./dist/pending.d.ts",
      "default": "./dist/pending.js"
    },
    "./prompts": {
      "types": "./dist/prompts.d.ts",
      "default": "./dist/prompts.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  }
}
